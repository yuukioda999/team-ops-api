APP_NAME=team-ops-api
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=team_ops
DB_USERNAME=team_ops
DB_PASSWORD=team_ops

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# ローカル以外では未設定でも true になる。HTTPS のない環境で動かすときだけ false にする
# SESSION_SECURE_COOKIE=

# Web(Vite)からの API 呼び出しを Cookie のセッションで認証する(ADR-0008)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000

# 信頼するプロキシ(Vite・nginx)。回数制限で利用者のIPを数えるのに使う
TRUSTED_PROXIES=

# メールアドレス照合用ハッシュの鍵(ADR-0003)。APP_KEY とは別の値にする
# 作り方: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
BLIND_INDEX_KEY=

# デモモード(spec 007)。有効にすると宛先の制限も有効になる
DEMO_MODE=false
# 宛先を .invalid ドメインだけに制限する(ローカル開発用。DEMO_MODE=true なら常に有効)
RECIPIENTS_INVALID_ONLY=false

# notify-relay(メール配信)。secret は notify-relay の RELAY_SIGNING_KEYS と同じ値(base64、32バイト以上)
NOTIFY_RELAY_URL=http://notify-relay:8080
NOTIFY_RELAY_KEY_ID=
NOTIFY_RELAY_SECRET=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
